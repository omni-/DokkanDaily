@page "/daily"
@rendermode InteractiveServer

@using DokkanDaily.Components.Shared
@using DokkanDaily.Constants
@using DokkanDaily.Helpers
@using DokkanDaily.Models;
@using DokkanDaily.Models.ViewModel
@using DokkanDaily.Models.Enums
@using DokkanDaily.Services
@using DokkanDaily.Services.Interfaces

@inject IRngHelperService RngSvc
@inject IAzureBlobService BlobSvc
@inject IJSRuntime JsRuntime
@inject NavigationManager NavManager

<PageTitle>Dokkandle!</PageTitle>

<style>
    body {
    background: url('images/misc/wallpaper.jpg') fixed center no-repeat;
    background-size: cover;
    text-align: center;
    margin: 0 auto;
    }
</style>

<Logo dailyType="@TodaysDailyType" />


@if (Executing || TodaysChallenge is null)
{
    <BusySpinner />
}
else
{
    <section class="challenge-box" aria-labelledby="challenge-heading">
        <header class="challenge-heading">
            <div><span class="eyebrow">A new battle every day</span><h1 id="challenge-heading">Today's challenge</h1></div>
            <span class="challenge-type">@TodaysDailyType</span>
        </header>
        <div class="challenge-body">
            <section class="mission-rule" aria-label="Team requirement">
                <span class="step-label">01 / Build your team</span>
                @if (TodaysChallenge.DailyType == DailyType.Character)
                {
                    <div class="leader-line">
                    <a class="card-art unit-info-link" href="@($"https://dokkaninfo.com/cards/{TodaysChallenge.TodaysUnit.Id}")" target="_blank" rel="noopener noreferrer" aria-label="@($"View {TodaysChallenge.Leader.Name} on Dokkan Info (opens in a new tab)")" title="View unit on Dokkan Info">
                        <img class="card-thumb-bg" src="@BgUrl" alt="" />
                        <img class="card-thumb-character" src="@TodaysChallenge.TodaysUnit.ImageUrl" alt="" />
                        <img class="card-rarity" src="@RarityUrl" alt="" />
                        <img class="card-element" src="@TypeUrl" alt="" />
                        @if (TodaysChallenge.TodaysUnit.Rarity == "LR")
                        {
                            <img class="card-lightning" src="images/misc/LR_lightning.png" alt="" />
                        }
                    </a>
                        <div><p class="unit-title">@TodaysChallenge.Leader.Title</p><h2>@TodaysChallenge.Leader.Name</h2><p class="friend-text">Use as your leader or friend unit. Only one required.</p></div>
                    </div>
                }
                @if (TodaysChallenge.DailyType == DailyType.LinkSkill)
                {
                    <h2>One link. A whole team.</h2>
                    <p>Use only units with this Link Skill:</p>
                    <div class="dokkan-link-wrapper"><div class="dokkan-link"><div class="text">@TodaysChallenge.LinkSkill.Name</div></div></div>
                    <p class="friend-text">Your friend unit is exempt.</p>
                }
                @if (TodaysChallenge.DailyType == DailyType.Category)
                {
                    <h2>Assemble your category team</h2>
                    <p>Use only units belonging to:</p>
                    <img class="category-art" src="@TodaysChallenge.Category.ImageURL" alt="@TodaysChallenge.Category.Name" />
                    <p class="friend-text">Your friend unit is exempt.</p>
                }
            </section>
            <section class="mission-event" aria-label="Target stage">
                <span class="step-label">02 / Take on the stage</span>
                <div class="event-heading"><h2>@TodaysChallenge.TodaysEvent.Name</h2><span class="stage-number">Stage @TodaysChallenge.TodaysEvent.StageNumber</span></div>
                @if (!string.IsNullOrEmpty(TodaysChallenge.TodaysEvent.BannerImagePath))
                {
                    @if (TodaysChallenge.TodaysEvent.DokkanInfoUrl is string stageUrl)
                    {
                        <a class="stage-info-link" href="@stageUrl" target="_blank" rel="noopener noreferrer" aria-label="@($"View {TodaysChallenge.TodaysEvent.FullName} on Dokkan Info (opens in a new tab)")">
                            <img class="event-banner" src="@TodaysChallenge.TodaysEvent.BannerImagePath" alt="@TodaysChallenge.TodaysEvent.Name" />
                            <span class="stage-info-caption">Stage details on Dokkan Info <span aria-hidden="true">&nearr;</span></span>
                        </a>
                    }
                    else
                    {
                        <img class="event-banner" src="@TodaysChallenge.TodaysEvent.BannerImagePath" alt="@TodaysChallenge.TodaysEvent.Name" />
                    }
                }
            </section>
            <div class="challenge-actions">
                <div><strong>Think you can clear it?</strong>
                    @if (!isDuringReset)
                    {
                        <p>@dailyFileCount @(dailyFileCount == 1 ? "clear" : "clears") uploaded today</p>
                    }
                </div>
                <button disabled="@isDuringReset" type="button" class="battle-button" @onclick="OnClick">View clears <span aria-hidden="true">&nearr;</span></button>
            </div>
        </div>
        <div class="reset-status">@TimeUntil</div>
    </section>

    <Footer />
}

@code {
    Challenge TodaysChallenge;

    bool Executing { get; set; }

    string typeColor => DokkanConstants.TypeHexMap[TodaysChallenge.TodaysUnit.DokkanType];

    int dailyFileCount = 0;

    int hoursToReset => 24 - DateTime.UtcNow.Hour;

    private bool isDuringReset => Worker.GetWorkSchedule(Models.Enums.WorkType.DailyReset).IsDuringReset(TimeOnly.FromDateTime(DateTime.UtcNow));

    string TimeUntil => isDuringReset ? "Calculating results..." : "Time until challenge resets: " + (hoursToReset > 1 ? $"{hoursToReset} hours" : $"{59 - DateTime.UtcNow.Minute} minute(s)");

    string BgUrl => $"images/misc/card_bg_{TodaysChallenge?.TodaysUnit?.Type}.png";

    string RarityUrl => $"images/misc/{TodaysChallenge?.TodaysUnit?.Rarity}.png";

    string TypeUrl => $"images/misc/{TodaysChallenge?.TodaysUnit?.Class}_{TodaysChallenge?.TodaysUnit?.Type}.png";

    string EzaIconUrl => "";

    string TodaysDailyType => TodaysChallenge is null ? null : TodaysChallenge.DailyType.ToString();

    protected override async Task OnInitializedAsync()
    {
        TodaysChallenge = await RngSvc.GetDailyChallenge();

        try
        {
            dailyFileCount = await BlobSvc
                .GetFileCountForTag(DokkanDailyHelper.GetUtcNowDateTag())
                .ConfigureAwait(false);
        }
        catch { }

        base.OnInitialized();
    }

    // A full navigation guarantees that Clears is prerendered with the current request address,
    // which is then persisted into its interactive component state.
    void OnClick() => NavManager.NavigateTo("/clears", true);
}
