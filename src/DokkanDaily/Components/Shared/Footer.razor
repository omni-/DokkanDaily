@inject NavigationManager NavManager

<footer>
    <div>
        <img style="cursor:pointer" @onclick="@(() => NavManager.NavigateTo("/leaderboard", false))" src="images/misc/leaderboard_icon.png" />
    </div>
    <div>
        <a href="https://github.com/omni-/DokkanDaily"><img class="link-icon" src="images/misc/github.png" /></a>
    </div>
    <div>
        <a href="https://discord.gg/2D426TZtfK"><img class="link-icon" src="images/misc/discord.png" /></a>
    </div>
    <div>
        <a href='https://ko-fi.com/F1F41B2IUO'><img class="link-icon" src='images/misc/kofi_symbol.png' /></a>
    </div>
    <Microsoft.AspNetCore.Components.Authorization.CascadingAuthenticationState>
        <Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
            @* Both endpoints end in a full page load - one to Discord's consent screen, one to the
               sign-out redirect - so they are plain links. Routing them through NavigateTo(forceLoad:
               true) tore the circuit down while its own navigation interop call was still in flight,
               which surfaced as a TaskCanceledException and flashed the error banner on the way out. *@
            <Authorized>
                <a class="auth-button" href="deauth">Log out</a>
            </Authorized>
            <NotAuthorized>
                <a class="auth-button" href="auth">Login</a>
            </NotAuthorized>
        </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
    </Microsoft.AspNetCore.Components.Authorization.CascadingAuthenticationState>
</footer>
